# ============================================================================
# PixelForge AI — environment configuration
#
# Copy to `.env` and adjust. `.env` is git-ignored and must never contain
# secrets that are shared. Every value below has a working default; the file
# exists so you can override them without editing code.
# ============================================================================

# ---------------------------------------------------------------- application
ENVIRONMENT=development           # development | production | test
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                   # text | json  (use json for aggregation)

# ---------------------------------------------------------------- http
HOST=127.0.0.1
PORT=8000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- storage
STORAGE_DIR=./storage
MODELS_DIR=./models
DATABASE_URL=sqlite+aiosqlite:///./storage/pixelforge.db

# ---------------------------------------------------------------- upload limits
MAX_UPLOAD_SIZE_MB=32
MAX_INPUT_PIXELS=16000000         # ~16 MP (e.g. 4000x4000); guards decompression bombs
MIN_INPUT_DIMENSION=32
MAX_OUTPUT_PIXELS=200000000       # refuse jobs whose result would be unmanageable
ALLOWED_FORMATS=JPEG,PNG,WEBP

# ---------------------------------------------------------------- inference
DEVICE=auto                       # auto | cuda | cpu
DEFAULT_MODEL=RealESRGAN_x4plus
DEFAULT_SCALE=4
TILE_SIZE=256                     # 0 disables tiling; 256 suits a 4 GB GPU
TILE_PAD=16
USE_FP16=true                     # ignored on CPU, where fp32 is faster
MAX_CONCURRENT_JOBS=1             # GPU inference serialises; keep at 1 for one GPU

# ---------------------------------------------------------------- retention
TEMP_RETENTION_HOURS=24
MAX_TOTAL_STORAGE_GB=10
CLEANUP_INTERVAL_MINUTES=30

# ---------------------------------------------------------------- frontend
# Empty means "same origin" — the Vite dev server proxies /api, and in Docker
# nginx does. Set this only when the API lives on a different host.
VITE_API_BASE_URL=
VITE_BACKEND_PROXY=http://127.0.0.1:8000
VITE_APP_VERSION=0.1.0
